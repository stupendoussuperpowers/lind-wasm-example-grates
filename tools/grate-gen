int main(int argc, char *argv[]) {
  if (argc < 2) {
    fprintf(stderr, "Usage: %s <cage_file>\\n", argv[0]);
    exit(EXIT_FAILURE);
  }

  int grateid = getpid();

  pid_t pid = fork();
  if (pid < 0) {
    perror("fork failed");
    exit(EXIT_FAILURE);
  } else if (pid == 0) {
    int cageid = getpid();
    register_handlers(cageid, grateid);

    if (execv(argv[1], &argv[1]) == -1) {
      perror("execv failed");
      exit(EXIT_FAILURE);
    }
  } else {
    grate_init();
  }

  int status;
  while (wait(&status) > 0) {
    grate_destroy();
  }

  return 0;
}
"""


@dataclass
class ParamInfo:
    name: str
    type_str: str
    is_pointer: bool
    index: int
    direction: Optional[str]
    size: Optional[str]

    def from_arg(arg, idx):
        direction, size = None, None

        for child in arg.get_children():
            if child.kind == CursorKind.ANNOTATE_ATTR:
                text = child.spelling
                direction, size = text.split(":")
                break

        return ParamInfo(
            name=arg.spelling or f"arg{idx}",
            type_str=arg.type.spelling,
            is_pointer=arg.type.kind == TypeKind.POINTER,
            direction=direction,
            size=size,
            index=idx
        )


@dataclass
class FunctionInfo:
    name: str
    return_type: str
    params: List[ParamInfo]

    def from_cursor(cursor):
        func_name = cursor.spelling
        return_type = cursor.result_type.spelling

        params = []

        for i, arg in enumerate(cursor.get_arguments()):
            params.append(ParamInfo.from_arg(arg, i))

        return FunctionInfo(
            name=func_name,
            return_type=return_type,
            params=params
        )

    def generate_decl(self):
        params = []

        for i, param in enumerate(self.params):
            params.append(f"{param.type_str}")

        params = ','.join(params)

        return f"{self.return_type} {self.name}({params});"

    def generate_wrapper(self):
        extract = []
        copy_in = []
        copy_out = []
        free_code = []
        allocs = []

        param_list = []

        for i, param in enumerate(self.params):
            param_list.append(f"{param.name}")

            if i == 0:
                continue

            if not param.direction:
                extract.append(f"{param.type_str} {
                               param.name} = arg{param.index};")
            else:
                allocs.append(ALLOC.format(
                    type_str=param.type_str,
                    name=param.name,
                    size=param.size))

                if "in" in param.direction:
                    free_code.append(f"free({param.name});")

                    copy_in.append(COPY.format(
                        targetcage=f"arg{param.index}cage",
                        src=f"arg{param.index}",
                        srccage=f"arg{param.index}cage",
                        dest=f"(uint64_t){param.name}",
                        destcage="thiscage",
                        len=f"{param.size}",
                        copytype=1 if param.size == 256 else 0,
                        type_str=param.type_str,
                        name=param.name,
                        size=param.size))

                if "out" in param.direction:
                    free_code.append(f"free({param.name});")

                    copy_out.append(COPY.format(
                        targetcage=f"arg{param.index}cage",
                        dest=f"arg{param.index}",
                        destcage=f"arg{param.index}cage",
                        src=f"(uint64_t){param.name}",
                        srccage="thiscage",
                        len=f"{param.size}",
                        copytype=1 if param.size == 256 else 0,
                        type_str=param.type_str,
                        name=param.name,
                        size=param.size))

        return SIGNATURE.format(
            return_type=f"{self.return_type}",
            func_name=f"{self.name}",
            extract=''.join(extract),
            allocs=''.join(allocs),
            copy_in=''.join(copy_in),
            copy_out=''.join(copy_out),
            free_code=''.join(free_code),
            param_list=','.join(param_list)
        )


def get_handlers() -> List[FunctionInfo]:
    seen = set()

    def check_handler(cursor):
        for child in cursor.get_children():
            if child.kind == CursorKind.ANNOTATE_ATTR:
                if 'syscall' in child.spelling.lower():
                    sysnum = child.spelling.lower().split(":")[-1]
                    handler_table[sysnum] = cursor.spelling
                    return True
        return False

    def visit_node(cursor, lst):
        if cursor.kind == CursorKind.FUNCTION_DECL and check_handler(cursor):
            if cursor.spelling not in seen:
                lst.append(cursor)
                seen.add(cursor.spelling)
        for child in cursor.get_children():
            visit_node(child, lst)

    a = []

    visit_node(tu.cursor, a)

    return [FunctionInfo.from_cursor(i) for i in a]


def generate_registers():
    registers = []

    for k, v in handler_table.items():
        registers.append(REGISTER_HANDLER.format(
            sysnum=k, name=v
        ))

    return REGISTER_HANDLERS.format(handlers=''.join(registers))


def get_includes(tu):
    includes = []

    main_file = tu.spelling

    for i in tu.cursor.get_children():
        if i.kind == CursorKind.INCLUSION_DIRECTIVE:
            loc = i.location
            if not loc.file or loc.file.name != main_file:
                continue
            tks = ""
            for tk in i.get_tokens():
                tks += tk.spelling
            includes.append(tks)

    return includes


