SIGNATURE = """{return_type} {func_name}_grate(
uint64_t cageid,
uint64_t arg1, uint64_t arg1cage,
uint64_t arg2, uint64_t arg2cage,
uint64_t arg3, uint64_t arg3cage,
uint64_t arg4, uint64_t arg4cage,
uint64_t arg5, uint64_t arg5cage,
uint64_t arg6, uint64_t arg6cage) {{

    int thiscage = getpid();

    {extract}

    {allocs}

    {copy_in}

    {return_type} ret = {func_name}({param_list});

    {copy_out}

    {free_code}

    return ret;
}}
"""

ALLOC = """
{type_str} {name} = malloc({size});

if({name} == NULL) {{
    perror("malloc failed");
    return -1;
}}
"""

COPY = """
copy_data_between_cages(
    thiscage,
    {targetcage},
    {src},
    {srccage},
    {dest},
    {destcage},
    {len},
    {copytype}
);
"""

REGISTER_HANDLERS = """
void register_handlers(int cageid, int grateid) {{
    {handlers}
}}
"""

REGISTER_HANDLER = """
register_handler(cageid, {sysnum}, 1, grateid, (uint64_t)(uintptr_t)&{name}_grate);
"""

